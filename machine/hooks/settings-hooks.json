{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{HOOKS_DIR}}/record-film-action.py\"",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{HOOKS_DIR}}/record-film-action.py\"",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{HOOKS_DIR}}/record-film-action.py\" --stop",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{HOOKS_DIR}}/record-film-action.py\" --messages",
            "async": true,
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{PYTHON}}\" \"{{HOOKS_DIR}}/record-film-action.py\" --messages",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
